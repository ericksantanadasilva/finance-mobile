# Copie para .env (fora do Git) e ajuste os valores.
# Variáveis EXPO_PUBLIC_* vão embutidas no app: nunca coloque segredos aqui.
# Depois de alterar, reinicie o `npx expo start` e recarregue o app.

# URL do backend (financeiro). Em desenvolvimento: IP do PC na rede + porta do `npm run dev`.
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
